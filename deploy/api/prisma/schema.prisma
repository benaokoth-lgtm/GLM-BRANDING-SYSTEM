// Dev datasource is SQLite for zero-setup local development. For production,
// flip provider to "postgresql" and point DATABASE_URL at a Postgres instance
// — the models below are written to be compatible with both. The cPanel
// deploy build (scripts/build-cpanel.mjs, see DEPLOYMENT.md) writes a copy of this
// schema with the provider already flipped to postgresql into deploy/api — keep
// this line as sqlite in what you commit.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int       @id @default(autoincrement())
  // The full name used everywhere (login screen, orders, reports) — always first + middle + surname joined.
  name             String
  // The name as captured: first name and surname are compulsory, the middle name is optional. Empty only for staff added before names were
  // captured in parts, until they are filled in from `name` at start-up (see staffNames.ts).
  firstName        String    @default("")
  middleName       String    @default("")
  lastName         String    @default("")
  // Statutory identifiers for payroll and the P9 (Compliance → Employees). All optional; National ID and KRA PIN are unique among staff when given
  // (checked by the API, not the database, so nothing about existing rows can block a deploy).
  nationalId       String?
  kraPin           String?
  shifNumber       String?
  role             String // free-text role name — must match a Role.name row (validated at write time, not a DB-level FK so existing rows survive a role rename's own migration)
  pinHash          String
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())

  // Used for the Admin's emailed PIN-reset code and for the Admin to email anyone their login PIN (Master Data → Staff & Users).
  // Set with `reset-pin.js "Name" --email ...` or under Master Data.
  // Stored lowercase. resetCodeHash is a bcrypt hash of a 6-digit code, never
  // the code itself.
  email            String?   @unique
  resetCodeHash    String?
  resetCodeExpires DateTime?
  resetAttempts    Int       @default(0)
  // Set when the Admin emails someone a PIN: they must choose their own at first login.
  mustChangePin    Boolean   @default(false)

  orders        Order[]
  payments      Payment[]
  payrollEntries PayrollEntry[]
  productionTasks ProductionTask[] @relation("TaskAssignee")
  qualityChecks   QualityCheck[]   @relation("CheckInspector")
  clientOwnerships ClientOwner[]
  commissionPayouts CommissionPayout[]
}

// A role is now a configurable row, not a fixed union — Master Data → Roles
// & Access lets Admin add/rename roles (e.g. "Accountant") and toggle which
// areas of the app each role can reach. 'Admin' itself is never a row here —
// the server always treats the literal name 'Admin' as having every
// permission regardless of this table's contents (see permissions.ts), and
// that name is reserved (rejected on create/rename below) — a fixed
// recovery path so a permissions mistake elsewhere can never lock every user
// out of the system. Each Boolean below gates one nav area/action (see
// PermissionKey in packages/shared/src/types.ts); requirePermission() in
// apps/api/src/middleware/auth.ts looks these up live on every gated
// request (not baked into the JWT), so a permission change takes effect for
// a user immediately, without needing to log out and back in.
model Role {
  id                Int     @id @default(autoincrement())
  name              String  @unique
  canCaptureOrders  Boolean @default(false)
  canViewAllOrders  Boolean @default(false)
  canManagePayments Boolean @default(false)
  canAccessPnl      Boolean @default(false)
  canAccessFinance  Boolean @default(false)
  canAccessStock    Boolean @default(false)
  canApproveStock   Boolean @default(false)
  canAccessReports  Boolean @default(false)
  canAccessDtf      Boolean @default(false) // DTF tracker: record film sales & artwork jobs
  canManageDtf      Boolean @default(false) // DTF tracker: roll costs, Setup, profit/wastage dashboard
  canAccessProduction Boolean @default(false) // Production: see and work the jobs assigned to you (start, finish, record output)
  canManageProduction Boolean @default(false) // Production: see every order, assign staff, track productivity and output
  canAccessQuality    Boolean @default(false) // Quality control: inspect finished orders (pass → ready, fail → back to production)
  canSeeCosts         Boolean @default(false) // sees supplier costs and mark-ups on outsourced jobs (everyone else sees selling prices only)
  canAccessAccounting Boolean @default(false) // Accounting: chart of accounts, journals, notes, payables/receivables, statements, M-Pesa matching
  canReceiveStock     Boolean @default(false) // Stores: receive purchased goods into the store (enter the quantities that physically arrived)
  canManageCommission Boolean @default(false) // Sales Commission: settings, every staff member's statement, client ownership, approving and paying commission
}

// The lines of business income is reported under: DTF Printing, UV Printing, Laser Engraving, Large Format Printing, Embroidery and
// General Order. Every service belongs to one; a material sold over the counter counts as General Order.
model BusinessHead {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  services  Service[]
  materials Material[]
  expenses  Expense[]
  purchaseLines PurchaseLine[]
}

model Service {
  id                  Int     @id @default(autoincrement())
  businessHeadId      Int?
  businessHead        BusinessHead? @relation(fields: [businessHeadId], references: [id])
  name                String
  unit                String // 'piece' | 'metre' | 'sqm'
  price               Float
  // An sqm-priced service billed off one artwork's area (length x width) —
  // e.g. DTF Printing or Embroidery. Governs whether order line items show
  // the "Artwork size (sqm)" field and compute unit price
  // as area x this service's Ksh/sqm rate (see LineItemsEditor.tsx).
  // Editable by Admin in Master Data.
  usesArtworkPricing  Boolean @default(false)
  // Jobs where GLM prints AND heat-presses (not a pure film sale) show a
  // staff-picked heat press fee (Ksh/piece) on the line item, added on top
  // of the base price. Editable by Admin in Master Data.
  chargesPressingFee  Boolean @default(false)
  // True only for "DTF Printing" / "DTF Sheet (per metre)" — these are sold
  // exclusively through the DTF Sales & Roll Tracker's own order-capture
  // flow (see routes/dtf.ts), not picked as a line item in New Walk-in
  // Order (LineItemsEditor filters them out there). The Service row itself
  // still exists and is still referenced by OrderLineItem.serviceId on the
  // orders that flow creates, purely so revenue reports (Sales by Category)
  // keep grouping by service name correctly. Not exposed as a Master Data
  // toggle — set once via seed, since there are exactly two such rows.
  soldViaDtfModule    Boolean @default(false)
  // Contracted-out services (e.g. eulogy printing, banners, screen printing). The supplier quotes ONE price that includes paper/material
  // and the service, VAT included; we add a mark-up (a percentage, or a fixed amount per unit) to get the selling price (also VAT
  // inclusive). These are defaults — the actual quote is captured per job, on the order line. Cost and mark-up are hidden from anyone
  // without the "see costs" permission.
  outsourced          Boolean @default(false)
  supplierName        String  @default("")
  markupType          String  @default("percent") // percent | amount
  markupValue         Float   @default(0)
  defaultSupplierCost Float? // supplier's usual price per unit, VAT included (optional)
  // The Income account this service's sales post to (null = a default picked by
  // name when the chart is built — see accounting/chart.ts).
  accountId           Int?
  account             Account? @relation("ServiceAccount", fields: [accountId], references: [id])
  lineItems           OrderLineItem[]
}

model Material {
  id           Int    @id @default(autoincrement())
  name         String
  price        Float
  stockQty     Float  @default(0)
  reorderLevel Float  @default(0)
  // The business head this material is normally bought for — purchases of it are tagged to it unless changed on the purchase order.
  businessHeadId Int?
  businessHead   BusinessHead? @relation(fields: [businessHeadId], references: [id])
  // Income account for sales of this material (null = Merchandise & Materials Sales).
  accountId    Int?
  account      Account? @relation("MaterialAccount", fields: [accountId], references: [id])
  lineItems    OrderLineItem[]
  requisitions StockRequisition[]
  requisitionLines StockRequisitionLine[] @relation("RequisitionLineMaterial")
  stockTakes   StockTake[]
  purchases    Purchase[]
  purchaseLines PurchaseLine[] @relation("PurchaseLineMaterial")
}

// A physical count reconciliation — staff count what's actually on the
// shelf, and the system's stockQty (drifted from requisitions, wastage,
// miscounts) is corrected to match. systemQty/varianceQty are snapshotted
// at count time so the discrepancy stays visible even after stockQty is
// updated.
model StockTake {
  id             Int      @id @default(autoincrement())
  materialId     Int
  material       Material @relation(fields: [materialId], references: [id])
  date           String // 'YYYY-MM-DD'
  systemQty      Float // Material.stockQty immediately before this count
  countedQty     Float // physical count
  varianceQty    Float // countedQty - systemQty
  note           String   @default("")
  countedByName  String
  countedAt      DateTime @default(now())
}

model CorporateClient {
  id         Int     @id @default(autoincrement())
  name       String
  creditDays Int     @default(30)
  // Used to prefill the "Send email"/"Send WhatsApp" targets on that
  // client's invoices/quotations — optional since not every client has
  // both on file yet.
  email      String  @default("")
  phone      String  @default("")
  orders     Order[]
}

model Setting {
  id             Int     @id @default(1)
  // The company's KRA PIN — printed as the employer's PIN on the payroll and the P9.
  kraPin         String  @default("")
  maxDiscountPct Float   @default(15)
  nextWalkinNo   Int     @default(1001)
  nextCorpNo     Int     @default(2001)
  // Order numbering for the DTF Sales & Roll Tracker's own order-capture
  // flow ('F-' prefix, for "Film") — kept separate from nextWalkinNo so
  // Film/Artwork orders are visually distinct in order lists even though
  // they're still kind: 'walkin' under the hood.
  nextDtfNo      Int     @default(3001)

  // Company profile — used on printed invoices, quotations, and receipts.
  companyName    String  @default("GLM Branding")
  // The registered company behind the "GLM Branding" trading name — the
  // uploaded logo is GLM Group Limited's, so printed invoices/quotations
  // show it as a small "trading name of ..." line under the brand name
  // rather than as an unexplained second name next to the logo (see
  // apps/web/src/utils/printInvoice.ts). Blank hides the line entirely.
  legalName      String  @default("GLM Group Limited")
  companyAddress String  @default("")
  companyPhone   String  @default("")
  companyEmail   String  @default("")
  logoDataUrl    String? // base64 data: URL, stored inline (small file, no object storage in this app)

}

model Expense {
  id              Int      @id @default(autoincrement())
  date            String // 'YYYY-MM-DD'
  category        String
  note            String   @default("")
  amount          Float
  // RETIRED — input VAT is now worked out automatically from the expense head (ExpenseHead.vatApplicable), not stored per expense. The
  // column is kept only so databases that already have it need no destructive change.
  vatAmount       Float    @default(0)
  // Invoice/receipt number — optional for expenses generally, but required
  // for a "Printing Materials & Consumables" expense to be linkable to a
  // stock Purchase (see Purchase.expenseId): only an expense with an
  // invoice number on file can be picked as "already bought" when
  // capturing a purchase.
  invoiceNumber   String?
  capturedByName  String   @default("")
  // How it was paid. Every expense used to come out of petty cash, so that is the default for rows
  // that pre-date this field. paid = false means bought on credit: it sits in Accounts Payable
  // until ExpensePayment rows settle it.
  method          String   @default("Petty Cash")
  paid            Boolean  @default(true)
  supplier        String   @default("")
  dueDate         String?
  amendments      ExpenseAmendment[]
  purchase        Purchase?
  payments        ExpensePayment[]
  notes           AdjustmentNote[]
  // Set when this is a supplier bill for an outsourced job — it is that job's cost.
  orderId         Int?
  order           Order?   @relation(fields: [orderId], references: [id])
  // The line of business this cost belongs to (null = shared, not tagged to one).
  businessHeadId  Int?
  businessHead    BusinessHead? @relation(fields: [businessHeadId], references: [id])
}

// A payment made against an expense bought on credit (partial payments allowed).
model ExpensePayment {
  id             Int     @id @default(autoincrement())
  expenseId      Int
  expense        Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  date           String // 'YYYY-MM-DD'
  amount         Float
  method         String
  note           String  @default("")
  capturedByName String  @default("")
}

// An expense head (the old fixed EXPENSE_CATEGORIES list, now editable) and the Expense account it posts to.
model ExpenseHead {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  // Does spending on this head carry 16% VAT that is claimed back (input VAT)? null = the standing answer for its name (see
  // defaultExpenseVatApplicable in shared/tax.ts); an Admin can set it either way on Compliance → VAT.
  vatApplicable Boolean?
  accountId Int?
  account   Account? @relation("ExpenseHeadAccount", fields: [accountId], references: [id])
}

// A correction request against an existing Expense — never edits the row
// directly. Applied to the Expense only once approved, so a wrong entry
// stays intact (and in the P&L numbers as originally logged) until a
// finance manager/general manager/admin signs off on the fix.
model ExpenseAmendment {
  id               Int       @id @default(autoincrement())
  expenseId        Int
  expense          Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  proposedDate     String
  proposedCategory String
  proposedNote     String    @default("")
  proposedAmount   Float
  reason           String
  status           String    @default("Pending") // Pending | Approved | Rejected
  requestedByName  String
  requestedAt      DateTime  @default(now())
  decidedByName    String?
  decidedAt        DateTime?
}

// Finance > Payroll — a pay-run log. Employees are paid a fixed monthly
// salary entered directly as grossPay (daysWorked/rate stay null); Casuals
// are still day-rate (grossPay = daysWorked * rate, stored so a later
// rate-table change doesn't rewrite history). NSSF/SHIF/PAYE/Housing Levy
// are computed on read via packages/shared/src/tax.ts, never stored, same
// "compute from source, don't cache" rule as order totals. The staff name is
// looked up live via staffId (Master Data), not free text.
//
// paymentSource decides where the cash comes from: 'Bank/Cheque' has no
// further effect here, but 'Petty Cash' registers netPay as an outflow
// against the Petty Cash float (see finance.ts's computePettyCashBalance) —
// checked for sufficient balance before the entry is allowed to save, same
// rule as a plain Expense. grossPay (not netPay) is what feeds the P&L's
// "Salaries & wages" line (see pnl.ts) — Expense rows are no longer captured
// under that category at all, so there is exactly one place salary cost is
// entered, never two.
model PayrollEntry {
  id             Int     @id @default(autoincrement())
  date           String // 'YYYY-MM-DD'
  staffId        Int
  staff          User    @relation(fields: [staffId], references: [id])
  employeeType   String // 'Employee' | 'Casual'
  department     String  @default("")
  daysWorked     Float? // Casual only
  rate           Float? // Casual only (day-rate)
  grossPay       Float // Employee: fixed monthly salary entered directly. Casual: daysWorked * rate.
  paymentSource  String // 'Petty Cash' | 'Bank/Cheque'
  capturedByName String  @default("")
}

// Finance > Petty Cash — the "in" side of the float (bank withdrawals or cash
// sales allocated to petty cash). Only reachable via the Finance router,
// which is Finance-Manager/General-Manager/Admin gated, so every top-up is
// inherently manager-authorized; authorizedByName snapshots who did it for
// the ledger display. The "out" side is the Expense ledger plus any
// PayrollEntry paid via 'Petty Cash' (netPay only — see computePettyCashBalance) —
// running balance = all-time top-ups minus all-time expenses minus all-time
// petty-cash-sourced payroll net pay (on read).
model PettyCashTopUp {
  id               Int    @id @default(autoincrement())
  date             String // 'YYYY-MM-DD'
  source           String // 'Bank Withdrawal' | 'Cash Sales Allocation'
  amount           Float
  note             String @default("")
  authorizedByName String
}

// Generic deletion-approval gate for Expense / PayrollEntry / PettyCashTopUp —
// no direct delete button anywhere for these three anymore; deleting always
// goes through a request (with a reason) that a *different* finance
// manager/general manager/admin must approve before the row actually goes.
// No FK to the target row (recordType/recordId instead) since one model
// covers three different tables; `summary` snapshots what's being deleted so
// the request stays legible even after the row is gone.
model DeletionRequest {
  id              Int       @id @default(autoincrement())
  recordType      String // 'Expense' | 'PayrollEntry' | 'PettyCashTopUp'
  recordId        Int
  summary         String
  reason          String
  status          String    @default("Pending") // Pending | Approved | Rejected
  requestedByName String
  requestedAt     DateTime  @default(now())
  decidedByName   String?
  decidedAt       DateTime?
}

// Stock > Requisition/Approval — approving a requisition only authorizes
// buying it; it no longer touches Material.stockQty itself (see Purchase
// below for what actually does). A requisition can have more than one
// Purchase attempt against it — e.g. a first purchase gets rejected at
// reconciliation and a corrected one is captured afterward — so this isn't
// a one-to-one relation.
model StockRequisition {
  id              Int        @id @default(autoincrement())
  // REQ-0001, REQ-0002… — assigned when the requisition is raised.
  ref             String?    @unique
  // LEGACY single-line fields (before requisitions had many lines). New requisitions leave these empty and use `lines`;
  // existing rows are converted to one line on start-up (see requisitions.ts) and keep these only as a record.
  materialId      Int?
  material        Material?  @relation(fields: [materialId], references: [id])
  qty             Float?
  lines           StockRequisitionLine[]
  note            String     @default("")
  status          String     @default("Pending") // Pending | Approved | Rejected
  requestedByName String
  requestedAt     DateTime   @default(now())
  decidedByName   String?
  decidedAt       DateTime?
  purchases       Purchase[]
}

// One material and quantity on a requisition.
model StockRequisitionLine {
  id            Int              @id @default(autoincrement())
  requisitionId Int
  requisition   StockRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  materialId    Int
  material      Material         @relation("RequisitionLineMaterial", fields: [materialId], references: [id])
  qty           Float
  // The unit price expected when the requisition is raised — what the purchases reconciliation compares the real price against.
  estUnitCost   Float?
}

// Stock > Purchases — the held-then-released middle stage between a
// requisition and stock actually increasing, mirroring the Olerai Hotel
// System's purchase-order capture/approve-receipt flow: a purchase is
// captured here (supplier, quantity/cost actually bought, invoice number)
// and sits "Held" — Material.stockQty is NOT touched yet — until a
// different manager reconciles what was requisitioned against what was
// actually purchased (varianceQty) and either accepts it into the store
// (the only thing that releases it into stockQty) or rejects it for
// re-capture. Same segregation-of-duties rule as every other
// approve/reject in this app: the capturer can't also accept their own
// purchase. requisitionId is optional — a purchase can also be raised
// standalone, with no prior requisition.
model Purchase {
  id               Int               @id @default(autoincrement())
  requisitionId    Int?
  requisition      StockRequisition? @relation(fields: [requisitionId], references: [id])
  // PO-0001, PO-0002… — the purchase order reference, given when the purchase is captured.
  poRef            String?           @unique
  // LEGACY single-material fields (before a purchase had many lines). New purchases leave materialId empty and use `lines`; older
  // rows are converted to one line on start-up (see purchases.ts) and keep these only as a record.
  materialId       Int?
  material         Material?         @relation(fields: [materialId], references: [id])
  lines            PurchaseLine[]
  date             String // 'YYYY-MM-DD' purchased/received
  supplier         String            @default("")
  qty              Float             @default(0) // legacy: quantity of the single material
  unitCost         Float             @default(0) // legacy
  totalCost        Float // the whole purchase: the sum of its lines
  receiveNote      String?
  invoiceNumber    String?
  // "New purchase creates the Expense" / "already logged, pick it from a
  // dropdown" linkage — an Expense can back at most one purchase (enforced
  // via this being @unique).
  expenseId        Int?              @unique
  expense          Expense?          @relation(fields: [expenseId], references: [id])
  status           String            @default("Held") // Held | Accepted | Rejected
  requisitionedQty Float? // snapshot of what was requisitioned, for the variance shown at acceptance
  varianceQty      Float? // qty - requisitionedQty, snapshotted at acceptance (null if there was no requisition to compare against)
  acceptedByName   String?
  acceptedAt       DateTime?
  rejectReason     String?
  capturedByName   String
  createdAt        DateTime          @default(now())
}

// One material on a purchase order: what was bought, at what price, and what the store manager counted in.
model PurchaseLine {
  id          Int      @id @default(autoincrement())
  purchaseId  Int
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  materialId  Int
  material    Material @relation("PurchaseLineMaterial", fields: [materialId], references: [id])
  qty         Float // purchased (as invoiced)
  unitCost    Float
  totalCost   Float
  receivedQty Float? // entered by the store manager on receipt; null until received
  // Which line of business this was bought for — what Reports → Sales by Business Head charges the cost to. Null = not tagged.
  businessHeadId Int?
  businessHead   BusinessHead? @relation(fields: [businessHeadId], references: [id])
}

model Order {
  id                Int      @id @default(autoincrement())
  orderNo           String   @unique
  kind              String // 'walkin' | 'corporate'
  // 'general' (New Walk-in Order / corporate quote-invoice flow) vs 'dtf'
  // (captured via the DTF Sales & Roll Tracker's Film Sale / Artwork Job
  // order popup — see routes/dtf.ts). Lets "My Orders" filter the two apart
  // without joining to DtfFilmSale/DtfArtworkJob.
  channel           String   @default("general")
  customerName      String?
  phone             String?
  corporateClientId Int?
  corporateClient   CorporateClient? @relation(fields: [corporateClientId], references: [id])
  staffId           Int
  staff             User     @relation(fields: [staffId], references: [id])
  createdDate       String // 'YYYY-MM-DD'
  status            String // 'Quote' | 'Invoice' | 'Order'
  stage             String // production stage, see shared STAGES
  // Corporate invoices: due date from the client's credit terms. Walk-in/DTF
  // orders left with a balance at capture also get one now (see
  // WALKIN_INVOICE_DUE_DAYS), so status can move to 'Invoice' there too —
  // see convertQuoteToInvoice's sibling logic in routes/orders.ts and
  // routes/dtf.ts's order-creation blocks.
  dueDate           String?
  // Handover: the order is Completed only when the customer receives it. Normally that needs it paid in full; handing it over
  // with a balance (onCredit) turns the order into an invoice that is then collected through Accounts Receivable.
  handedOverAt        DateTime?
  handedOverByName    String?
  handedOverOnCredit  Boolean   @default(false)
  paymentTiming     String? // 'onAcceptance' | 'onCompletion' — walk-in only
  orderDiscountPct  Float    @default(0)
  orderDiscountAmt  Float    @default(0)

  // Sales commission. A client sourced by a staff member is credited to them for 12 months (see ClientOwner), so every order from
  // that client carries the owner's id here — whoever captured it. 'sourced' = credited to sourcedByStaffId, 'house' = nobody.
  // Nobody shares a client or an order. (A plain id rather than a relation: it is a credit, not a link that must always resolve.)
  salesSource       String   @default("house")
  sourcedByStaffId  Int?
  clientKey         String? // how this client is recognised across orders — see clientKeyFor in shared/commission.ts

  lineItems         OrderLineItem[]
  payments          Payment[]
  mpesaTransactions MpesaTransaction[]
  dtfFilmSale       DtfFilmSale?
  dtfArtworkJob     DtfArtworkJob?
  notes             AdjustmentNote[]
  expenses          Expense[]
  productionTasks   ProductionTask[]
  qualityChecks     QualityCheck[]
}

// A line item is either a standalone material sale (Cap, Polo Shirt, canvas,
// ...) or a standalone service fee (DTF Printing, Embroidery, Large Format
// Printing, ...) — never both. Selling and servicing the same physical item
// (e.g. print a client's own cap) is two separate line items: a 'material'
// line for the cap and a 'service' line for the print job, rather than one
// combined row — so serviceId/materialId are each optional, with exactly one
// set per row depending on itemType (validated at the API layer).
model OrderLineItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType    String // 'material' | 'service' | 'per-metre'
  serviceId   Int?
  service     Service? @relation(fields: [serviceId], references: [id])
  materialId  Int?
  material    Material? @relation(fields: [materialId], references: [id])
  qty         Float
  unitPrice   Float
  discountPct Float    @default(0)
  discountAmt Float    @default(0)
  // Staff-picked heat press fee (Ksh/piece), added to unitPrice before qty
  // and discounts — only meaningful when service.chargesPressingFee is true.
  heatPressFee Float?
  // Single-artwork print area (sqm) — only meaningful when service.unit is
  // 'sqm' and service.usesArtworkPricing is true (e.g. DTF Printing,
  // Embroidery — priced per sqm/artwork rather than per piece or running
  // metre). qty × artworkAreaSqm gives the per-piece price (area ×
  // service.price, the Ksh/sqm rate), computed client-side into unitPrice,
  // stored here too for traceability.
  artworkAreaSqm Float?
  // Outsourced services only: the supplier's quote for THIS job (per unit, VAT included), the mark-up that produced the selling
  // price, and who the supplier is. Visible only to people who can see costs; null until someone costs the job.
  supplierName String?
  supplierCost Float?
  markupType   String?
  markupValue  Float?
}

model Payment {
  id       Int    @id @default(autoincrement())
  orderId  Int
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date     String
  amount   Float
  method   String
  // M-Pesa receipt code / bank or card reference, when there is one — what makes a payment
  // matchable against the M-Pesa statement.
  reference String?
  mpesaTransactionId Int? @unique
  mpesaTransaction   MpesaTransaction? @relation(fields: [mpesaTransactionId], references: [id])
  staffId  Int?
  staff    User?  @relation(fields: [staffId], references: [id])
}

// One STK push request/result. orderId is set once the push is tied to a
// specific order's balance (Payments/order-detail flow); null for a push
// sent before the order exists yet (walk-in capture — see NewWalkinOrder.tsx),
// in which case the frontend creates the order only after this row reaches
// 'Success'. checkoutRequestId is Safaricom's handle for the push, used both
// by the callback (to find this row) and by the frontend's status poll.
// resultCode/mpesaReceipt are populated once Safaricom's callback (or, in an
// environment with no reachable public callback URL, a manual "confirm
// received" fallback — see routes/mpesa.ts) reports the outcome.
model MpesaTransaction {
  id                Int      @id @default(autoincrement())
  checkoutRequestId String   @unique
  merchantRequestId String
  phone             String
  amount            Float
  accountReference  String
  status            String   @default("Pending") // Pending | Success | Failed | Cancelled
  resultCode        Int?
  resultDesc        String?
  mpesaReceipt      String?   @unique
  orderId           Int?
  order             Order?   @relation(fields: [orderId], references: [id])
  confirmedManually Boolean  @default(false)
  createdByName     String
  createdAt         DateTime @default(now())
  // 'STK' = a push we sent; 'C2B' = a Paybill/Till payment Safaricom told us about; 'Import' = a line
  // from an uploaded M-Pesa statement. For the last two, status runs Unmatched -> Applied | Dismissed.
  kind              String   @default("STK")
  payerName         String   @default("")
  receivedOn        String? // 'YYYY-MM-DD' the money arrived (C2B / Import)
  appliedByName     String?
  appliedAt         DateTime?
  dismissedNote     String?
  rawJson           String   @default("{}")
  payment           Payment?
}

// Mail account the system sends email from — login PINs to staff, the Admin's PIN-reset code, invoices. Edited by the Admin under
// Master Data → Email (one row, id = 1). Laid out like the "mail client settings" cPanel shows for a mailbox. The password is never
// sent back to the browser once saved. When nothing is saved, the SMTP_* environment variables are still honoured (see mailer.ts).
model MailSettings {
  id           Int      @id @default(1)
  username     String   @default("") // the full mailbox address, e.g. admin@glmgroup.co.ke
  password     String   @default("")
  outgoingHost String   @default("") // SMTP server
  smtpPort     Int      @default(465) // 465 = SSL/TLS (recommended); 587 = STARTTLS
  incomingHost String   @default("") // IMAP / POP3 server — recorded for reference; the system only sends
  imapPort     Int      @default(993)
  pop3Port     Int      @default(995)
  fromName     String   @default("") // e.g. "GLM Branding POS"
  loginUrl     String   @default("") // the address staff sign in at, quoted in the PIN email
  updatedAt    DateTime @updatedAt
}

// M-Pesa (Daraja) setup, edited by the Admin under Master Data → M-Pesa. One row (id = 1). The consumer secret and passkey are
// never sent back to the browser once saved — the screen only confirms they are set. When no row has been saved yet, the app
// still honours the old MPESA_* environment variables (see mpesaConfig.ts), so existing installs keep working.
model MpesaSettings {
  id              Int       @id @default(1)
  enabled         Boolean   @default(false)
  environment     String    @default("sandbox") // sandbox | production
  shortCode       String    @default("")
  isTill          Boolean   @default(false) // a Till (Buy Goods) takes an STK push amount only — a Paybill takes an account reference too
  consumerKey     String    @default("")
  consumerSecret  String    @default("")
  passkey         String    @default("")
  publicBaseUrl   String    @default("") // this server's own https address — Safaricom must be able to reach it
  callbackSecret  String    @default("") // random path segment only this install and Safaricom's callbacks know
  c2bRegisteredAt DateTime?
  updatedAt       DateTime  @updatedAt
}

// Finance > Asset Register — fixed-asset tracking (machines, vehicles,
// computers, furniture), separate from Material (consumable stock sold to
// customers) and StockItem-style inventory. Modeled on the Olerai Hotel
// System's own Asset Register (same machine, sibling project — read to
// match its shape): a tag/name/category/quantity/location record with a
// condition lifecycle (Active/Under Repair/Retired) changed directly, no
// approval workflow — this is routine record-keeping, not a spend decision
// (that already happened at purchase time; Value here is just what's on
// record for book-value/insurance purposes, not linked to Expense the way
// Purchase is, since a capital asset purchase is typically a one-off already
// captured under Finance → Expenses however the business normally records
// it).
model Asset {
  id           Int       @id @default(autoincrement())
  tag          String    @unique
  name         String
  category     String // Printing Equipment | Embroidery Machines | Heat Press & Curing | Computers & IT Equipment | Furniture & Fixtures | Vehicles | Office Equipment | Other
  quantity     Int       @default(1)
  location     String    @default("")
  condition    String    @default("Active") // Active | Under Repair | Retired
  purchaseDate String? // 'YYYY-MM-DD'
  value        Float?
  notes        String    @default("")
  createdByName String   @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // Automatic depreciation (accounting/depreciation.ts runs it monthly): value is the cost.
  depreciationMethod  String  @default("None") // None | Straight-line | Reducing balance
  usefulLifeYears     Float? // straight-line
  depreciationRatePct Float? // reducing balance, % of the opening book value per year
  salvageValue        Float   @default(0)
  // How the purchase was paid: Bank | Cash | M-Pesa | Petty Cash | On credit | Owner Capital (default for
  // assets recorded before this field — treated as already contributed by the owner).
  fundedBy            String  @default("Owner Capital")
  retiredOn           String?
  depreciations       AssetDepreciation[]
}

// One month's depreciation charge for one asset. (assetId, period) is unique, so the monthly job can be
// re-run any number of times without double-charging.
model AssetDepreciation {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  period    String // 'YYYY-MM'
  date      String // last day of that month
  amount    Float
  createdAt DateTime @default(now())

  @@unique([assetId, period])
}

// ── Accounting ──────────────────────────────────────────────────────────
// A double-entry ledger. Day-to-day activity (orders, payments, expenses, payroll, petty cash,
// depreciation, notes) is NOT copied in here — accounting/ledger.ts derives its postings from those tables on
// every read, so the books cannot drift from operations. Only what has no operational home is stored:
// opening balances, owner capital/drawings, bank deposits, tax remittances and other hand-written journals.
model Account {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  type         String // Asset | Liability | Equity | Income | Expense
  subtype      String        @default("")
  description  String        @default("")
  system       Boolean       @default(false) // built-in accounts the ledger posts to — can be renamed, never deleted or retyped
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  lines        JournalLine[]
  expenseHeads ExpenseHead[] @relation("ExpenseHeadAccount")
  services     Service[]     @relation("ServiceAccount")
  materials    Material[]    @relation("MaterialAccount")
}

model JournalEntry {
  id              Int           @id @default(autoincrement())
  ref             String        @unique
  date            String // 'YYYY-MM-DD'
  memo            String
  source          String // Manual | Opening | Capital | Drawings | BankDeposit | TaxPayment
  createdByName   String        @default("")
  createdAt       DateTime      @default(now())
  lines           JournalLine[]
}

model JournalLine {
  id        Int          @id @default(autoincrement())
  entryId   Int
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId Int
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Float        @default(0)
  credit    Float        @default(0)
  memo      String       @default("")
}

// Credit / debit notes. 'Credit' takes a sale (and its VAT) back from a customer and reduces what they owe — or,
// for the part they had already paid, leaves them a credit (optionally refunded straight away). 'Debit' charges
// a customer more. 'SupplierDebit' is a note sent to a supplier (goods returned, a pricing error): it reduces what
// we owe them (or leaves them owing us) and reduces the expense it was booked to.
model AdjustmentNote {
  id              Int      @id @default(autoincrement())
  number          String   @unique // CN-yyyy-nnn | DN-yyyy-nnn | SDN-yyyy-nnn
  type            String // Credit | Debit | SupplierDebit
  date            String // 'YYYY-MM-DD'
  party           String
  orderId         Int?
  order           Order?   @relation(fields: [orderId], references: [id])
  expenseId       Int?
  expense         Expense? @relation(fields: [expenseId], references: [id])
  reason          String
  itemsJson       String? // the lines this note was raised for: [{lineId?, desc, qty, amount}]
  net             Float
  vat             Float    @default(0)
  total           Float
  receivableAmt   Float    @default(0) // credit note: the part that reduced Accounts Receivable
  creditAmt       Float    @default(0) // credit note: the part the customer had already paid (owed back to them)
  refundAmt       Float    @default(0) // credit note: of creditAmt, what was refunded on the day
  refundMethod    String?
  incomeAccountId Int? // debit note: the Income account the extra charge posts to
  restocked       Boolean  @default(false)
  createdByName   String   @default("")
  createdAt       DateTime @default(now())
}

// ── Production & Quality Control ────────────────────────────────────────
// Once an order is captured it is managed in Production. Order.stage moves only through these steps — nobody can set
// 'Completed' from Production or Quality:
//   Order Received (waiting) → assigned to a staff member → 'In Production'
//   → the worker records output and finishes → 'Quality Check'
//   → QC passes → 'Ready for Pickup/Delivery'   (QC fails → back to 'In Production' as rework)
//   → handed over to the customer → 'Completed' (the only way to complete an order — POST /orders/:id/handover)
model ProductionTask {
  id             Int       @id @default(autoincrement())
  orderId        Int
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // A job is either given to a staff member (assignee) or sent to a supplier (supplierName, no assignee). Supplier jobs come back
  // through "receive" and then go to Quality Control like any other.
  assigneeId     Int?
  assignee       User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  supplierName   String?
  assignedByName String    @default("")
  assignedAt     DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  status         String    @default("Assigned") // Assigned | In Progress | Finished | Superseded (reassigned before finishing)
  isRework       Boolean   @default(false) // raised by a failed quality check
  unitsPlanned   Float     @default(0) // pieces / metres on the order
  unitsCompleted Float? // what the worker reports having produced
  note           String    @default("")
  checks         QualityCheck[]

  @@index([assigneeId, status])
  @@index([orderId])
}

model QualityCheck {
  id             Int            @id @default(autoincrement())
  orderId        Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  taskId         Int?
  task           ProductionTask? @relation(fields: [taskId], references: [id])
  inspectorId    Int
  inspector      User           @relation("CheckInspector", fields: [inspectorId], references: [id])
  checkedAt      DateTime       @default(now())
  result         String // Passed | Failed
  unitsInspected Float?
  unitsRejected  Float          @default(0)
  defects        String         @default("")
  note           String         @default("")

  @@index([orderId])
}

// ── DTF Sales & Roll Tracker ────────────────────────────────────────────
// Ported from the DTF workbook (formulas live in packages/shared/src/dtf.ts).
// Separate from the order/POS flow: this tracks physical film rolls and what
// each one earned. Sales and jobs snapshot the price band/multiplier they were
// saved with, so later Setup changes never re-price history.

// Single row (id = 1), created on first read.
model DtfSetting {
  id                  Int   @id @default(1)
  rollLengthM         Float @default(100)
  rollWidthCm         Float @default(60)
  stdPricePerM        Float @default(500) // film sale ceiling — used by saleCalc only
  minPricePerM        Float @default(400) // used by saleCalc only
  wastageTolerancePct Float @default(5)
  // Artwork-job billing (see jobCalc in packages/shared/src/dtf.ts): every
  // piece pays this floor plus a share of a fixed per-running-metre charge,
  // split across however many pieces that metre covers — billed against the
  // metre regardless of how much of the roll's width it filled.
  minPricePerPiece    Float @default(30)
  fixedChargePerMetre Float @default(2160)
}

model DtfRoll {
  id            String   @id // 'ROLL-001'
  installedOn   String // 'YYYY-MM-DD' — a roll is "started" once it has this
  finishedOn    String?
  status        String   @default("open") // open | closed
  filmCost      Float    @default(0)
  inkPowderCost Float    @default(0)
  rollLengthM   Float // snapshot of Setup at install
  createdByName String   @default("")
  createdAt     DateTime @default(now())

  filmSales   DtfFilmSale[]
  artworkJobs DtfArtworkJob[]
}

model DtfFilmSale {
  id             Int      @id @default(autoincrement())
  rollId         String
  roll           DtfRoll  @relation(fields: [rollId], references: [id])
  soldOn         String
  client         String   @default("")
  metres         Float
  pricePerM      Float // resolved price charged (server-validated within min..std)
  stdPriceAtSale Float // Setup snapshot
  minPriceAtSale Float
  amountPaid     Float    @default(0)
  capturedByName String   @default("")
  createdAt      DateTime @default(now())
  // The Order this sale's "Record sale" popup generated (line items, payment,
  // receipt/invoice) — see POST /dtf/sales. Optional only because it's a
  // later addition; every sale created going forward always has one.
  // onDelete: SetNull since nothing in this app actually deletes an Order
  // outside the dev seed script's full-table wipe — the sale record itself
  // should survive that, just with its order link cleared.
  orderId        Int?     @unique
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model DtfArtworkJob {
  id               Int      @id @default(autoincrement())
  rollId           String
  roll             DtfRoll  @relation(fields: [rollId], references: [id])
  jobOn            String
  client           String   @default("")
  // Physical film consumed — what the roll's remaining balance is drawn
  // down by, and what the fixed charge below is billed against.
  runningMetres    Float
  pieces           Int
  fixedChargePerMetreAtJob Float @default(2160) // Setup snapshot, so a later Setup change never re-prices history
  minPricePerPieceAtJob    Float @default(30) // Setup snapshot, same reasoning
  // What was really charged per piece when staff charged MORE than the system-recommended price (null = the recommended price). The
  // amount above the recommendation is what earns the staff member commission.
  chargedPerPiece  Float?
  // A job priced BELOW the recommended price waits for a manager's approval ('Pending') before it can be paid for or produced. Its film
  // metres are reserved on the roll meanwhile, but its revenue is not counted. Rejected jobs are removed (the PriceApproval row keeps the record).
  approvalStatus   String   @default("Approved") // Pending | Approved
  capturedByName   String   @default("")
  createdAt        DateTime @default(now())
  // The Order this job's "Record job" popup generated — see POST /dtf/jobs.
  // Optional for the same reason, and onDelete: SetNull for the same reason,
  // as DtfFilmSale.orderId above.
  orderId          Int?     @unique
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

// ── Staff sales commission ───────────────────────────────────────────────
// A client a staff member brings in through their own network is credited to them for ownershipMonths (12). While the window is open
// every order from that client is credited to the owner, whoever captures it; nobody else can claim the client. After the window the
// client is free again and can be sourced anew. Clients are recognised by clientKey (see clientKeyFor in shared/commission.ts).
model ClientOwner {
  id          Int      @id @default(autoincrement())
  clientKey   String
  clientName  String
  staffId     Int
  staff       User     @relation(fields: [staffId], references: [id])
  startDate   String // 'YYYY-MM-DD' — when the staff member sourced the client
  endDate     String // 'YYYY-MM-DD' — the last day the client is credited to them
  status      String   @default("Active") // Active | Released (let go early by a manager)
  releasedOn  String?
  releasedBy  String?
  note        String   @default("")
  createdByName String @default("")
  createdAt   DateTime @default(now())

  @@index([clientKey])
}

// One row (id 1): the rates. Commission is on money RECEIVED; every figure is editable because there is no sales history to calibrate to yet.
model CommissionSettings {
  id               Int      @id @default(1)
  // The on/off switch (Master Data → Company Info, Admin only). Off until someone decides to start paying commission: while it is off the
  // Commission module is hidden, nobody can claim a client, and orders are not credited to anyone.
  enabled          Boolean  @default(false)
  // General sales — marginal bands on a staff member's monthly NET sales received: [{from, rate}] (see Band in shared/commission.ts)
  generalBandsJson String   @default("[{\"from\":0,\"rate\":0},{\"from\":150000,\"rate\":2},{\"from\":300000,\"rate\":3.5},{\"from\":500000,\"rate\":5}]")
  // Film — KES per metre charged ABOVE the base (the DTF minimum price) → % of that slice. No ceiling.
  filmBandsJson    String   @default("[{\"from\":0,\"rate\":10},{\"from\":25,\"rate\":25},{\"from\":50,\"rate\":40},{\"from\":75,\"rate\":50}]")
  // Artwork — % of the amount charged above the system-recommended price
  artworkRatePct   Float    @default(50)
  ownershipMonths  Int      @default(12)
  updatedByName    String   @default("")
  updatedAt        DateTime @updatedAt
}

// A month's commission for one staff member, approved by a manager and later paid. Approving freezes the figures; paying records the
// expense (category 'Sales Commission') so it reaches the books.
model CommissionPayout {
  id            Int      @id @default(autoincrement())
  period        String // 'YYYY-MM' — the month the money was received
  staffId       Int
  staff         User     @relation(fields: [staffId], references: [id])
  generalAmount Float    @default(0)
  filmAmount    Float    @default(0)
  artworkAmount Float    @default(0)
  amount        Float // what is payable
  detailJson    String   @default("{}") // the working at the time of approval
  status        String   @default("Approved") // Approved | Paid
  approvedByName String  @default("")
  approvedAt    DateTime @default(now())
  paidOn        String?
  paidMethod    String?
  paidByName    String?
  expenseId     Int?

  @@unique([period, staffId])
}

// A request to charge less than the recommended price on an artwork job. The job (and its order) stay on hold until a DTF manager
// approves or rejects it; the person who captured it cannot decide it. Rejecting removes the order and the job — this row is the record.
model PriceApproval {
  id               Int      @id @default(autoincrement())
  orderId          Int?     // cleared when a rejection removes the order
  orderNo          String
  rollId           String
  client           String   @default("")
  pieces           Int
  runningMetres    Float
  systemPerPiece   Float
  chargedPerPiece  Float
  shortfall        Float    // (recommended − charged) × pieces — what is being given away
  valueAtRecommended Float
  valueAtCharged   Float
  requestedById    Int
  requestedByName  String
  requestedAt      DateTime @default(now())
  status           String   @default("Pending") // Pending | Approved | Rejected
  decidedByName    String?
  decidedAt        DateTime?
  reason           String?
}
