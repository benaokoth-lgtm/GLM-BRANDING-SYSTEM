# SQLite for local dev; switch provider in prisma/schema.prisma and point this
# at a Postgres connection string for production (see DEPLOYMENT.md — the
# cPanel deploy does the provider switch for you via scripts/set-db-provider.mjs).
DATABASE_URL="file:./dev.db"

# Required in production (server refuses to boot without it there).
JWT_SECRET="change-me-in-production"

# Not needed on cPanel — Passenger sets its own PORT and the app just reads it.
PORT=4100

# Comma-separated list of allowed origins for CORS in production.
CORS_ORIGINS="http://localhost:5174"

# Optional — email sending ("Send email" on invoices/quotations) is disabled
# (returns a clear 501) until all four of these are set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset. SMTP is also used for the Admin "Forgot PIN?" emailed code.
SMTP_FROM=

# NOTE: M-Pesa is now set up by the Admin under Master Data → M-Pesa (stored in the database). The MPESA_* variables below are only
# the older way: an install that has not saved settings there yet keeps working from them, and the first save carries them over.
# Optional — M-Pesa STK Push is disabled until all five of these are set.
# MPESA_ENV: "sandbox" (default) or "production". MPESA_CALLBACK_URL must be a
# publicly reachable HTTPS URL Safaricom can call back — in production this is
# https://api.glmgroup.co.ke/api/mpesa/callback (only reachable once deployed;
# sandbox testing needs a tunnel like ngrok for local dev).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Optional — M-Pesa payment MATCHING for Paybill/Till payments made without a prompt (Accounting → M-Pesa Matching).
# Set a long random secret (16+ chars; it becomes part of the callback URL Safaricom calls), then an Admin registers the URLs once
# with POST /api/mpesa/c2b/register. MPESA_PUBLIC_URL defaults to the origin of MPESA_CALLBACK_URL. Without these, upload the
# M-Pesa statement instead — matching works from that too.
MPESA_C2B_SECRET=
MPESA_PUBLIC_URL=
