// Dev datasource is SQLite for zero-setup local development. For production,
// flip provider to "postgresql" and point DATABASE_URL at a Postgres instance
// — the models below are written to be compatible with both.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  role             String // 'Staff' | 'Supervisor' | 'Finance Manager' | 'General Manager' | 'Admin'
  pinHash          String
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())

  orders        Order[]
  payments      Payment[]
  payrollEntries PayrollEntry[]
}

model Service {
  id        Int    @id @default(autoincrement())
  name      String
  unit      String // 'piece' | 'metre' | 'sqm'
  price     Float
  lineItems OrderLineItem[]
}

model Material {
  id           Int    @id @default(autoincrement())
  name         String
  price        Float
  stockQty     Float  @default(0)
  reorderLevel Float  @default(0)
  lineItems    OrderLineItem[]
  requisitions StockRequisition[]
}

model CorporateClient {
  id         Int     @id @default(autoincrement())
  name       String
  creditDays Int     @default(30)
  orders     Order[]
}

model Setting {
  id             Int     @id @default(1)
  maxDiscountPct Float   @default(15)
  nextWalkinNo   Int     @default(1001)
  nextCorpNo     Int     @default(2001)

  // Company profile — used on printed invoices, quotations, and receipts.
  companyName    String  @default("GLM Branding")
  companyAddress String  @default("")
  companyPhone   String  @default("")
  companyEmail   String  @default("")
  logoDataUrl    String? // base64 data: URL, stored inline (small file, no object storage in this app)

  // Cost-of-sales assumption for the P&L account — % of accrual revenue, shared/editable by Supervisor+Admin.
  cogsPct Float @default(40)
}

model Expense {
  id              Int      @id @default(autoincrement())
  date            String // 'YYYY-MM-DD'
  category        String
  note            String   @default("")
  amount          Float
  capturedByName  String   @default("")
  amendments      ExpenseAmendment[]
}

// A correction request against an existing Expense — never edits the row
// directly. Applied to the Expense only once approved, so a wrong entry
// stays intact (and in the P&L numbers as originally logged) until a
// finance manager/general manager/admin signs off on the fix.
model ExpenseAmendment {
  id               Int       @id @default(autoincrement())
  expenseId        Int
  expense          Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  proposedDate     String
  proposedCategory String
  proposedNote     String    @default("")
  proposedAmount   Float
  reason           String
  status           String    @default("Pending") // Pending | Approved | Rejected
  requestedByName  String
  requestedAt      DateTime  @default(now())
  decidedByName    String?
  decidedAt        DateTime?
}

// Finance > Payroll — a pay-run log (not a fixed salary record), so casual
// day-rate labour and salaried staff share one entry shape. NSSF/SHIF are
// derived views over this same data; statutory deductions (PAYE/NSSF/SHIF/
// Housing Levy) are computed on read via packages/shared/src/tax.ts, never
// stored, same "compute from source, don't cache" rule as order totals.
// The staff name is looked up live via staffId (Master Data), not free text.
model PayrollEntry {
  id             Int    @id @default(autoincrement())
  date           String // 'YYYY-MM-DD'
  staffId        Int
  staff          User   @relation(fields: [staffId], references: [id])
  employeeType   String // 'Employee' | 'Casual'
  department     String @default("")
  daysWorked     Float
  rate           Float
  grossPay       Float // daysWorked * rate, stored so a later rate-table change doesn't rewrite history
  paymentMethod  String
  capturedByName String @default("")
}

// Finance > Petty Cash — the "in" side of the float (bank withdrawals or cash
// sales allocated to petty cash). Only reachable via the Finance router,
// which is Finance-Manager/General-Manager/Admin gated, so every top-up is
// inherently manager-authorized; authorizedByName snapshots who did it for
// the ledger display. The "out" side is the existing Expense ledger —
// running balance = all-time top-ups minus all-time expenses (on read).
model PettyCashTopUp {
  id               Int    @id @default(autoincrement())
  date             String // 'YYYY-MM-DD'
  source           String // 'Bank Withdrawal' | 'Cash Sales Allocation'
  amount           Float
  note             String @default("")
  authorizedByName String
}

// Stock > Requisition/Approval — a requested stock top-up only increases
// Material.stockQty once approved, so "available for sale" reflects
// approved stock, not merely requested stock.
model StockRequisition {
  id              Int       @id @default(autoincrement())
  materialId      Int
  material        Material  @relation(fields: [materialId], references: [id])
  qty             Float
  note            String    @default("")
  status          String    @default("Pending") // Pending | Approved | Rejected
  requestedByName String
  requestedAt     DateTime  @default(now())
  decidedByName   String?
  decidedAt       DateTime?
}

model Order {
  id                Int      @id @default(autoincrement())
  orderNo           String   @unique
  kind              String // 'walkin' | 'corporate'
  customerName      String?
  phone             String?
  corporateClientId Int?
  corporateClient   CorporateClient? @relation(fields: [corporateClientId], references: [id])
  staffId           Int
  staff             User     @relation(fields: [staffId], references: [id])
  createdDate       String // 'YYYY-MM-DD'
  status            String // 'Quote' | 'Invoice' | 'Order'
  stage             String // production stage, see shared STAGES
  dueDate           String? // corporate invoices only
  paymentTiming     String? // 'onAcceptance' | 'onCompletion' — walk-in only
  orderDiscountPct  Float    @default(0)
  orderDiscountAmt  Float    @default(0)

  lineItems OrderLineItem[]
  payments  Payment[]
}

model OrderLineItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType    String // 'material-service' | 'service-only' | 'per-metre'
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id])
  materialId  Int?
  material    Material? @relation(fields: [materialId], references: [id])
  qty         Float
  unitPrice   Float
  discountPct Float    @default(0)
  discountAmt Float    @default(0)
}

model Payment {
  id       Int    @id @default(autoincrement())
  orderId  Int
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date     String
  amount   Float
  method   String
  staffId  Int?
  staff    User?  @relation(fields: [staffId], references: [id])
}
