# Where the browser should send API requests. Leave unset for local dev — Vite's dev server
# proxies /api to apps/api on the same origin (see vite.config.ts), so relative /api paths
# just work.
#
# Required in production, since apps/web (static files) and apps/api (Node process) are
# deployed to separate subdomains — set this at BUILD time (baked into the static bundle, not
# read at runtime). Must include the "/api" suffix — apps/web/src/api/client.ts appends paths
# like "/orders" directly onto this value with no "/api" of its own:
#   VITE_API_URL=https://api.glmgroup.co.ke/api npm run build -w apps/web
VITE_API_URL=
