// Dev datasource is SQLite for zero-setup local development. For production,
// flip provider to "postgresql" and point DATABASE_URL at a Postgres instance
// — the models below are written to be compatible with both.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  role             String // free-text role name — must match a Role.name row (validated at write time, not a DB-level FK so existing rows survive a role rename's own migration)
  pinHash          String
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())

  orders        Order[]
  payments      Payment[]
  payrollEntries PayrollEntry[]
}

// A role is now a configurable row, not a fixed union — Master Data → Roles
// & Access lets Admin add/rename roles (e.g. "Accountant") and toggle which
// areas of the app each role can reach. 'Admin' itself is never a row here —
// the server always treats the literal name 'Admin' as having every
// permission regardless of this table's contents (see permissions.ts), and
// that name is reserved (rejected on create/rename below) — a fixed
// recovery path so a permissions mistake elsewhere can never lock every user
// out of the system. Each Boolean below gates one nav area/action (see
// PermissionKey in packages/shared/src/types.ts); requirePermission() in
// apps/api/src/middleware/auth.ts looks these up live on every gated
// request (not baked into the JWT), so a permission change takes effect for
// a user immediately, without needing to log out and back in.
model Role {
  id                Int     @id @default(autoincrement())
  name              String  @unique
  canCaptureOrders  Boolean @default(false)
  canViewAllOrders  Boolean @default(false)
  canManagePayments Boolean @default(false)
  canAccessPnl      Boolean @default(false)
  canAccessFinance  Boolean @default(false)
  canAccessStock    Boolean @default(false)
  canApproveStock   Boolean @default(false)
  canAccessFilm     Boolean @default(false)
  canAccessReports  Boolean @default(false)
}

model Service {
  id                  Int     @id @default(autoincrement())
  name                String
  unit                String // 'piece' | 'metre' | 'sqm'
  price               Float
  // DTF services consume transfer film — flagging a service here is what
  // makes its line items show the film-length capture field and feed the
  // Film roll inventory. Editable by Admin in Master Data.
  tracksFilm          Boolean @default(false)
  // Jobs where GLM prints AND heat-presses (not a pure film sale) show a
  // staff-picked heat press fee (Ksh/piece) on the line item, added on top
  // of the base price. Editable by Admin in Master Data.
  chargesPressingFee  Boolean @default(false)
  lineItems           OrderLineItem[]
}

// A flat-fee "quick pick" for common small DTF artwork sizes (e.g. 6cm x
// 6cm), as an alternative to the continuous area x Ksh/sqm formula on
// OrderLineItem. Small prints are dominated by fixed setup/press time, not
// material, so a pure area-based rate underprices them — a preset flat fee
// per known size fixes that while areaSqm still feeds the same film-length
// calc as any other artwork, so film-usage tracking stays exactly as
// accurate. Not tied to a specific Service — any sqm-priced, film-tracked
// service can use these. Editable by Admin in Master Data.
//
// Stored as length x width (not just area) so a captured artwork's real
// dimensions can be matched against a band as a bounding box — an artwork
// only "fits" a band if it fits within both the band's length AND width,
// since two shapes can share an area while one is too long/narrow to
// actually sit in a given slot. areaSqm is still stored (derived from
// lengthCm x widthCm server-side) since it's what feeds the film-length
// calc and is cheaper to read than recomputing everywhere.
model ArtworkSizeBand {
  id       Int    @id @default(autoincrement())
  label    String // e.g. "6cm x 6cm"
  lengthCm Float
  widthCm  Float
  areaSqm  Float
  price    Float // flat Ksh per piece at this size
}

model Material {
  id           Int    @id @default(autoincrement())
  name         String
  price        Float
  stockQty     Float  @default(0)
  reorderLevel Float  @default(0)
  lineItems    OrderLineItem[]
  requisitions StockRequisition[]
  stockTakes   StockTake[]
}

// A physical count reconciliation — staff count what's actually on the
// shelf, and the system's stockQty (drifted from requisitions, wastage,
// miscounts) is corrected to match. systemQty/varianceQty are snapshotted
// at count time so the discrepancy stays visible even after stockQty is
// updated — same "log the physical-vs-system mismatch" pattern as
// FilmRoll's waste-on-replacement.
model StockTake {
  id             Int      @id @default(autoincrement())
  materialId     Int
  material       Material @relation(fields: [materialId], references: [id])
  date           String // 'YYYY-MM-DD'
  systemQty      Float // Material.stockQty immediately before this count
  countedQty     Float // physical count
  varianceQty    Float // countedQty - systemQty
  note           String   @default("")
  countedByName  String
  countedAt      DateTime @default(now())
}

model CorporateClient {
  id         Int     @id @default(autoincrement())
  name       String
  creditDays Int     @default(30)
  // Used to prefill the "Send email"/"Send WhatsApp" targets on that
  // client's invoices/quotations — optional since not every client has
  // both on file yet.
  email      String  @default("")
  phone      String  @default("")
  orders     Order[]
}

model Setting {
  id             Int     @id @default(1)
  maxDiscountPct Float   @default(15)
  nextWalkinNo   Int     @default(1001)
  nextCorpNo     Int     @default(2001)

  // Company profile — used on printed invoices, quotations, and receipts.
  companyName    String  @default("GLM Branding")
  companyAddress String  @default("")
  companyPhone   String  @default("")
  companyEmail   String  @default("")
  logoDataUrl    String? // base64 data: URL, stored inline (small file, no object storage in this app)

  // Cost-of-sales assumption for the P&L account — % of accrual revenue, shared/editable by Supervisor+Admin.
  cogsPct Float @default(40)
}

model Expense {
  id              Int      @id @default(autoincrement())
  date            String // 'YYYY-MM-DD'
  category        String
  note            String   @default("")
  amount          Float
  // Invoice/receipt number — optional for expenses generally, but required
  // for a "DTF Film Rolls" expense to be linkable to a FilmRoll (see
  // FilmRoll.expenseId): only an expense with an invoice number on file can
  // be picked as "already bought" when installing a roll.
  invoiceNumber   String?
  capturedByName  String   @default("")
  amendments      ExpenseAmendment[]
  filmRoll        FilmRoll?
}

// A correction request against an existing Expense — never edits the row
// directly. Applied to the Expense only once approved, so a wrong entry
// stays intact (and in the P&L numbers as originally logged) until a
// finance manager/general manager/admin signs off on the fix.
model ExpenseAmendment {
  id               Int       @id @default(autoincrement())
  expenseId        Int
  expense          Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  proposedDate     String
  proposedCategory String
  proposedNote     String    @default("")
  proposedAmount   Float
  reason           String
  status           String    @default("Pending") // Pending | Approved | Rejected
  requestedByName  String
  requestedAt      DateTime  @default(now())
  decidedByName    String?
  decidedAt        DateTime?
}

// Finance > Payroll — a pay-run log. Employees are paid a fixed monthly
// salary entered directly as grossPay (daysWorked/rate stay null); Casuals
// are still day-rate (grossPay = daysWorked * rate, stored so a later
// rate-table change doesn't rewrite history). NSSF/SHIF/PAYE/Housing Levy
// are computed on read via packages/shared/src/tax.ts, never stored, same
// "compute from source, don't cache" rule as order totals. The staff name is
// looked up live via staffId (Master Data), not free text.
//
// paymentSource decides where the cash comes from: 'Bank/Cheque' has no
// further effect here, but 'Petty Cash' registers netPay as an outflow
// against the Petty Cash float (see finance.ts's computePettyCashBalance) —
// checked for sufficient balance before the entry is allowed to save, same
// rule as a plain Expense. grossPay (not netPay) is what feeds the P&L's
// "Salaries & wages" line (see pnl.ts) — Expense rows are no longer captured
// under that category at all, so there is exactly one place salary cost is
// entered, never two.
model PayrollEntry {
  id             Int     @id @default(autoincrement())
  date           String // 'YYYY-MM-DD'
  staffId        Int
  staff          User    @relation(fields: [staffId], references: [id])
  employeeType   String // 'Employee' | 'Casual'
  department     String  @default("")
  daysWorked     Float? // Casual only
  rate           Float? // Casual only (day-rate)
  grossPay       Float // Employee: fixed monthly salary entered directly. Casual: daysWorked * rate.
  paymentSource  String // 'Petty Cash' | 'Bank/Cheque'
  capturedByName String  @default("")
}

// Finance > Petty Cash — the "in" side of the float (bank withdrawals or cash
// sales allocated to petty cash). Only reachable via the Finance router,
// which is Finance-Manager/General-Manager/Admin gated, so every top-up is
// inherently manager-authorized; authorizedByName snapshots who did it for
// the ledger display. The "out" side is the Expense ledger plus any
// PayrollEntry paid via 'Petty Cash' (netPay only — see computePettyCashBalance) —
// running balance = all-time top-ups minus all-time expenses minus all-time
// petty-cash-sourced payroll net pay (on read).
model PettyCashTopUp {
  id               Int    @id @default(autoincrement())
  date             String // 'YYYY-MM-DD'
  source           String // 'Bank Withdrawal' | 'Cash Sales Allocation'
  amount           Float
  note             String @default("")
  authorizedByName String
}

// Generic deletion-approval gate for Expense / PayrollEntry / PettyCashTopUp —
// no direct delete button anywhere for these three anymore; deleting always
// goes through a request (with a reason) that a *different* finance
// manager/general manager/admin must approve before the row actually goes.
// No FK to the target row (recordType/recordId instead) since one model
// covers three different tables; `summary` snapshots what's being deleted so
// the request stays legible even after the row is gone.
model DeletionRequest {
  id              Int       @id @default(autoincrement())
  recordType      String // 'Expense' | 'PayrollEntry' | 'PettyCashTopUp'
  recordId        Int
  summary         String
  reason          String
  status          String    @default("Pending") // Pending | Approved | Rejected
  requestedByName String
  requestedAt     DateTime  @default(now())
  decidedByName   String?
  decidedAt       DateTime?
}

// Stock > Requisition/Approval — a requested stock top-up only increases
// Material.stockQty once approved, so "available for sale" reflects
// approved stock, not merely requested stock.
model StockRequisition {
  id              Int       @id @default(autoincrement())
  materialId      Int
  material        Material  @relation(fields: [materialId], references: [id])
  qty             Float
  note            String    @default("")
  status          String    @default("Pending") // Pending | Approved | Rejected
  requestedByName String
  requestedAt     DateTime  @default(now())
  decidedByName   String?
  decidedAt       DateTime?
}

model Order {
  id                Int      @id @default(autoincrement())
  orderNo           String   @unique
  kind              String // 'walkin' | 'corporate'
  customerName      String?
  phone             String?
  corporateClientId Int?
  corporateClient   CorporateClient? @relation(fields: [corporateClientId], references: [id])
  staffId           Int
  staff             User     @relation(fields: [staffId], references: [id])
  createdDate       String // 'YYYY-MM-DD'
  status            String // 'Quote' | 'Invoice' | 'Order'
  stage             String // production stage, see shared STAGES
  dueDate           String? // corporate invoices only
  paymentTiming     String? // 'onAcceptance' | 'onCompletion' — walk-in only
  orderDiscountPct  Float    @default(0)
  orderDiscountAmt  Float    @default(0)

  lineItems         OrderLineItem[]
  payments          Payment[]
  filmUsages        FilmUsage[]
  mpesaTransactions MpesaTransaction[]
}

// A line item is either a standalone material sale (Cap, Polo Shirt, canvas,
// ...) or a standalone service fee (DTF Printing, Embroidery, Large Format
// Printing, ...) — never both. Selling and servicing the same physical item
// (e.g. print a client's own cap) is two separate line items: a 'material'
// line for the cap and a 'service' line for the print job, rather than one
// combined row — so serviceId/materialId are each optional, with exactly one
// set per row depending on itemType (validated at the API layer).
model OrderLineItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType    String // 'material' | 'service' | 'per-metre'
  serviceId   Int?
  service     Service? @relation(fields: [serviceId], references: [id])
  materialId  Int?
  material    Material? @relation(fields: [materialId], references: [id])
  qty         Float
  unitPrice   Float
  discountPct Float    @default(0)
  discountAmt Float    @default(0)
  // Metres of DTF transfer film this line consumed — only meaningful when
  // service.tracksFilm is true; feeds a FilmUsage row on capture/conversion.
  filmLengthM Float?
  // Staff-picked heat press fee (Ksh/piece), added to unitPrice before qty
  // and discounts — only meaningful when service.chargesPressingFee is true.
  heatPressFee Float?
  // Single-artwork print area (sqm) — only meaningful when service.unit is
  // 'sqm' and service.tracksFilm is true (e.g. DTF Printing priced per
  // sqm/artwork rather than per running metre). qty × artworkAreaSqm gives
  // both the per-piece price (area × service.price, the Ksh/sqm rate) and
  // the total film consumed (÷ FILM_ROLL_WIDTH_M for linear metres) — both
  // computed client-side into unitPrice/filmLengthM, stored here too for
  // traceability.
  artworkAreaSqm Float?
  // When this DTF artwork was actually run through the press — null means
  // it's still sitting in the DTF Print Queue waiting to be gang-sheeted
  // with other small jobs (possibly from other clients/orders) into one
  // efficient print run. Only meaningful for sqm-priced, film-tracked
  // service lines; other line items never get marked.
  printedAt DateTime?
}

// DTF transfer-film roll inventory. One Active roll at a time; every metre
// consumed (auto-logged from a film-tracked order line, or manually fed) is
// a FilmUsage row that decrements it. Installing a new roll while the
// current one still shows a positive remaining balance means the physical
// roll ran out before the system's tally did — that shortfall is booked as
// waste on the old roll (not silently carried over), and avgRatePerMeter is
// snapshotted from its own usage history at that moment so the "did we
// undercharge this roll" comparison stays fixed once the roll is retired.
model FilmRoll {
  id              Int         @id @default(autoincrement())
  lengthM         Float
  costTotal       Float
  // Invoice/receipt number for the roll's purchase — either typed in when
  // logging a brand-new purchase (which also creates the linked Expense
  // below) or copied from an existing Expense picked at install time.
  invoiceNumber   String?
  // The Expense that funded this roll — set either by creating a new
  // Expense at install time, or by linking an existing "DTF Film Rolls"
  // expense (with an invoice number, not already linked elsewhere: @unique
  // here is what enforces "no expense can back two rolls"). Nullable only
  // for rolls installed before this linkage existed.
  expenseId       Int?        @unique
  expense         Expense?    @relation(fields: [expenseId], references: [id])
  installedDate   String // 'YYYY-MM-DD'
  installedByName String
  status          String      @default("Active") // Active | Finished
  finishedDate    String?
  wasteM          Float       @default(0)
  avgRatePerMeter Float? // snapshotted on finish — weighted avg revenue/metre this roll realized
  usages          FilmUsage[]
}

// One row per length of film consumed off the active roll — either
// auto-logged when a film-tracked order/quotation-conversion line goes to
// production, or manually logged when film is fed into the machine outside
// a captured order. ratePerMeter is the effective revenue/metre realized
// for that usage (lineTotal / filmLengthM for order-linked rows); null for
// usage with no associated sale (manual test feeds, waste corrections).
model FilmUsage {
  id             Int       @id @default(autoincrement())
  filmRollId     Int?
  filmRoll       FilmRoll? @relation(fields: [filmRollId], references: [id])
  date           String // 'YYYY-MM-DD'
  lengthM        Float
  source         String // 'Order' | 'Manual'
  orderId        Int?
  order          Order?    @relation(fields: [orderId], references: [id])
  ratePerMeter   Float?
  note           String    @default("")
  capturedByName String
}

model Payment {
  id       Int    @id @default(autoincrement())
  orderId  Int
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date     String
  amount   Float
  method   String
  staffId  Int?
  staff    User?  @relation(fields: [staffId], references: [id])
}

// One STK push request/result. orderId is set once the push is tied to a
// specific order's balance (Payments/order-detail flow); null for a push
// sent before the order exists yet (walk-in capture — see NewWalkinOrder.tsx),
// in which case the frontend creates the order only after this row reaches
// 'Success'. checkoutRequestId is Safaricom's handle for the push, used both
// by the callback (to find this row) and by the frontend's status poll.
// resultCode/mpesaReceipt are populated once Safaricom's callback (or, in an
// environment with no reachable public callback URL, a manual "confirm
// received" fallback — see routes/mpesa.ts) reports the outcome.
model MpesaTransaction {
  id                Int      @id @default(autoincrement())
  checkoutRequestId String   @unique
  merchantRequestId String
  phone             String
  amount            Float
  accountReference  String
  status            String   @default("Pending") // Pending | Success | Failed | Cancelled
  resultCode        Int?
  resultDesc        String?
  mpesaReceipt      String?
  orderId           Int?
  order             Order?   @relation(fields: [orderId], references: [id])
  confirmedManually Boolean  @default(false)
  createdByName     String
  createdAt         DateTime @default(now())
}
